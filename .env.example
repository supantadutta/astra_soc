# ==========================================================================
# ASTRASOC — environment configuration (copy to .env and adjust)
# ==========================================================================
# The DEMO profile runs with ZERO external credentials — every value below has
# a safe default. You only need to set these for development/production or to
# attach real LLM providers / connectors.

# --- Core -----------------------------------------------------------------
ASTRASOC_ENVIRONMENT=demo                 # development | demo | production | test
ASTRASOC_API_HOST=0.0.0.0
ASTRASOC_API_PORT=8000
ASTRASOC_LOG_LEVEL=INFO

# REQUIRED in production. In demo/dev a random per-process secret is generated.
# ASTRASOC_JWT_SECRET=change-me-to-a-long-random-string
ASTRASOC_ACCESS_TOKEN_TTL_SECONDS=3600

# --- Database -------------------------------------------------------------
# SQLite keeps the demo self-contained. Use Postgres for dev/prod:
# ASTRASOC_DATABASE_URL=postgresql+psycopg2://astrasoc:astrasoc@postgres:5432/astrasoc
ASTRASOC_DATABASE_URL=sqlite:///./astrasoc.db

# --- Operating mode -------------------------------------------------------
ASTRASOC_DEFAULT_MODE=DEMO                # DEMO | LIVE
ASTRASOC_ALLOW_LIVE_MODE=true             # set false to hard-lock to DEMO
ASTRASOC_DEMO_SEED_ON_STARTUP=true
ASTRASOC_DEMO_EVENT_INTERVAL_SECONDS=3

# --- CORS -----------------------------------------------------------------
ASTRASOC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional enterprise datastores --------------------------------------
# Leave unset to run degraded-but-functional. The platform reports these as
# "not configured" honestly rather than faking them.
# ASTRASOC_REDIS_URL=redis://redis:6379/0
# ASTRASOC_CLICKHOUSE_URL=http://clickhouse:8123
# ASTRASOC_NEO4J_URL=bolt://neo4j:7687
# ASTRASOC_OPENSEARCH_URL=http://opensearch:9200
# ASTRASOC_KAFKA_BROKERS=redpanda:9092
# ASTRASOC_TEMPORAL_HOST=temporal:7233
# ASTRASOC_OPA_URL=http://opa:8181
# ASTRASOC_VAULT_ADDR=http://vault:8200

# --- Secrets for real providers / connectors ------------------------------
# Secrets are referenced by URI (never stored in the DB or browser). With the
# built-in local secret manager, a reference vault://openai#api_key resolves to
# the env var below. Example:
# ASTRASOC_SECRET_OPENAI_API_KEY=sk-...
# ASTRASOC_SECRET_ANTHROPIC_API_KEY=sk-ant-...
# ASTRASOC_SECRET_SPLUNK_TOKEN=...

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
