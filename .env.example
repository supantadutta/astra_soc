# ==========================================================================
# ASTRASOC — environment configuration (copy to .env and adjust; never commit)
# ==========================================================================
# The demo profile needs none of this. For production, the API refuses to
# start until the REQUIRED values below are set safely.

# --- Core -----------------------------------------------------------------
ASTRASOC_ENVIRONMENT=demo                  # demo | development | production | test
ASTRASOC_LOG_LEVEL=INFO

# REQUIRED in production: ≥32 random chars each, and different from each other.
#   openssl rand -base64 48
# ASTRASOC_JWT_SECRET=
# ASTRASOC_AUDIT_KEY=
# Optional separate key (≥32 chars) for encrypting MFA secrets at rest;
# defaults to the audit key. Rotating it invalidates enrolled authenticators.
# ASTRASOC_DATA_ENCRYPTION_KEY=
ASTRASOC_ACCESS_TOKEN_TTL_SECONDS=3600

# --- Database -------------------------------------------------------------
# SQLite for the demo; PostgreSQL is required in production.
ASTRASOC_DATABASE_URL=sqlite:///./astrasoc.db
# ASTRASOC_DATABASE_URL=postgresql+psycopg2://astrasoc:<password>@postgres:5432/astrasoc
# ASTRASOC_AUTO_MIGRATE=true               # run alembic upgrade head on start-up

# --- First administrator (production; created once, when there are no users) --
# ASTRASOC_BOOTSTRAP_ADMIN_EMAIL=secops-admin@your-company.com
# ASTRASOC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Platform identity (the root provider tenant = your MSSP) -------------
# ASTRASOC_PLATFORM_TENANT_NAME="ASTRASOC Managed Security"
# ASTRASOC_PLATFORM_TENANT_SLUG=astrasoc

# --- Operating mode (per tenant; this is the default for new tenants) -----
ASTRASOC_DEFAULT_MODE=DEMO                 # DEMO | LIVE
ASTRASOC_ALLOW_LIVE_MODE=true              # false hard-locks the deployment to DEMO
ASTRASOC_DEMO_SEED_ON_STARTUP=true
ASTRASOC_DEMO_EVENT_INTERVAL_SECONDS=3

# --- HTTP -------------------------------------------------------------------
ASTRASOC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Ingress / reverse-proxy CIDRs whose X-Forwarded-For is trusted.
# ASTRASOC_TRUSTED_PROXIES=10.0.0.0/8
# ASTRASOC_RATE_LIMIT_PER_MINUTE=600       # per credential (or per IP if anonymous)
# ASTRASOC_AUTH_RATE_LIMIT_PER_MINUTE=20   # sign-in/refresh per client IP

# --- Browser sessions & MFA -------------------------------------------------
# Session cookies are HttpOnly + SameSite=Strict; Secure is on in production.
# ASTRASOC_COOKIE_SECURE=true
# Name shown in authenticator apps.
# ASTRASOC_MFA_ISSUER=ASTRASOC
# Seconds the refresh token superseded by the latest rotation stays usable
# (covers browsers that navigate mid-refresh). 0 disables; max 120.
# ASTRASOC_REFRESH_REUSE_GRACE_SECONDS=30

# --- Accounts ---------------------------------------------------------------
# ASTRASOC_PASSWORD_MIN_LENGTH=12
# ASTRASOC_LOGIN_MAX_FAILURES=5
# ASTRASOC_LOGIN_LOCKOUT_MINUTES=15

# --- Secrets --------------------------------------------------------------
# Connectors and model providers store secret REFERENCES only. Tenant
# references must be vault://tenants/<tenant-slug>/<path>#<field>.
#
# With HashiCorp Vault (KV v2):
# ASTRASOC_VAULT_ADDR=https://vault.internal:8200
# ASTRASOC_VAULT_TOKEN=
# ASTRASOC_VAULT_MOUNT=secret
#
# Without Vault, a reference resolves from an environment variable:
#   vault://tenants/acme/openai#api_key  ->  ASTRASOC_SECRET_TENANTS_ACME_OPENAI_API_KEY
# ASTRASOC_SECRET_TENANTS_ACME_OPENAI_API_KEY=
#
# env:// and file:// references are refused unless explicitly enabled (and then
# only for platform administrators). Not permitted in production.
# ASTRASOC_ALLOW_UNSAFE_SECRET_SCHEMES=false

# --- Outbound egress policy (connectors + LLM providers) ------------------
# Link-local / cloud-metadata addresses are always blocked.
# ASTRASOC_EGRESS_ALLOW_PRIVATE_NETWORKS=true
# ASTRASOC_EGRESS_ALLOW_LOOPBACK=false
# ASTRASOC_EGRESS_HOST_ALLOWLIST=.splunkcloud.com,api.openai.com

# --- Optional datastores (reported as "not configured" until wired) -------
# ASTRASOC_REDIS_URL=redis://redis:6379/0
# ASTRASOC_CLICKHOUSE_URL=http://clickhouse:8123
# ASTRASOC_NEO4J_URL=bolt://neo4j:7687
# ASTRASOC_OPENSEARCH_URL=http://opensearch:9200
# ASTRASOC_KAFKA_BROKERS=redpanda:9092
# ASTRASOC_TEMPORAL_HOST=temporal:7233
# ASTRASOC_OPA_URL=http://opa:8181

# --- Web tier (apps/web) ----------------------------------------------------
# Where the web tier's runtime /api proxy reaches the API.
API_INTERNAL_URL=http://localhost:8000
# true only when a reverse proxy in front of the web tier sets X-Forwarded-For.
WEB_TRUST_FORWARDED_FOR=false
